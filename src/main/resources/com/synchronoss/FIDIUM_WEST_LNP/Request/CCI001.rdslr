rule "CCI001" dialect "mvel" ruleflow-group "FIDIUM_WEST_LNP"

	 when
        //conditions
        xcb object
		Evaluate
Start Brace

Start Brace
the "/localservicerequest/lsrform/adminsection/reqtyp" is populated
		
AND
 the "/localservicerequest/lsrform/adminsection/act" is populated
End Brace

		
AND
 
Start Brace
the "/localservicerequest/lsrform/adminsection/reqtyp" is not equal to values "CB"
		
OR
 the "/localservicerequest/lsrform/adminsection/act" is not equal to values "V"
End Brace

End Brace

	then
		the error code "CCIE0001" with message "FDM Enterprises only supports Number Portability (REQTYP=CB) Conversion (ACT=V)" for the field "/localservicerequest/lsrform/adminsection/reqtyp"
		
end